{
  "name": "meal-swiper",
  "private": true,
  "version": "1.9.0",
  "author": "Giraffe Horizon <contact@giraffehorizon.com>",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dev": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run --coverage && playwright test",
    "prepare": "husky",
    "pages:build": "opennextjs-cloudflare build && npx wrangler deploy --config wrangler.workers.toml --dry-run --outdir .open-next/wrangler-bundle && node scripts/wrap-worker-for-pages.mjs .open-next/wrangler-bundle/worker.js .open-next/assets/_worker.js && cp .open-next/wrangler-bundle/*.wasm .open-next/assets/ 2>/dev/null || true && echo \"_worker.js\" > .open-next/assets/.assetsignore",
    "release": "semantic-release"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@auth/d1-adapter": "^1.11.2",
    "@google/generative-ai": "^0.24.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tanstack/react-query": "^5.101.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "framer-motion": "^12.40.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.3.3",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "semantic-release": "^25.0.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.35.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "undici": ">=7.24.0"
  }
}
